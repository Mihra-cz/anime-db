#!/usr/bin/env python3
"""LAB ONLY writer fence. The lab has no external writers; it verifies that no
running container other than the lab SMB server binds the lab share or RW mount.
Failure can be simulated with lab.sh hook-mode."""
import json
import subprocess
import sys

LAB = '/srv/animedb-v6-lab'
mode = json.load(open(LAB + '/stack/lab-hooks.json'))['stop_writers']
if mode != 'ok':
    print('LAB simulated writer fence failure', file=sys.stderr)
    raise SystemExit(1)
ids = subprocess.run(['/usr/bin/docker', 'ps', '-q'], capture_output=True, text=True, check=True).stdout.split()
offenders = []
for container in ids:
    info = json.loads(subprocess.run(['/usr/bin/docker', 'inspect', container], capture_output=True,
        text=True, check=True).stdout)[0]
    name = info['Name'].lstrip('/')
    sources = {m.get('Source', '') for m in info['Mounts']}
    if name != 'animedb-v6-lab-smb-smb-1' and any(s.startswith((LAB + '/mnt/rw', LAB + '/smb/share')) for s in sources):
        offenders.append(name)
if offenders:
    print('LAB writers still running: ' + ', '.join(offenders), file=sys.stderr)
    raise SystemExit(1)
print(json.dumps({'writers_stopped': True}))
