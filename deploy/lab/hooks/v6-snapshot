#!/usr/bin/env python3
"""LAB ONLY snapshot backend: an independent server-side copy of the synthetic
share, verified by a full content/metadata fingerprint and bound to the exact
manifest. It stands in for a Synology snapshot; it proves nothing about Synology.
Failure can be simulated with lab.sh hook-mode."""
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import sys

LAB = Path('/srv/animedb-v6-lab')
mode = json.load(open(LAB / 'stack/lab-hooks.json'))['snapshot']
binding = json.loads(sys.stdin.read(65536))
if (type(binding) is not dict or set(binding) != {'manifest_id', 'created_at', 'source_sha256'}
        or not all(re.fullmatch('[0-9a-f]{64}', binding[k]) for k in ('manifest_id', 'source_sha256'))):
    print('LAB snapshot binding invalid', file=sys.stderr)
    raise SystemExit(1)
if mode != 'ok':
    print('LAB simulated snapshot failure', file=sys.stderr)
    raise SystemExit(1)


def fingerprint(root):
    digest = hashlib.sha256()
    for path in sorted(root.rglob('*')):
        info = path.lstat()
        digest.update(f'{path.relative_to(root)}\0{info.st_mode}\0{info.st_size}\0{info.st_mtime_ns}\0'.encode())
        if path.is_file():
            digest.update(hashlib.sha256(path.read_bytes()).digest())
    return digest.hexdigest()


stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
snapshot_id = f'lab-{binding["manifest_id"][:16]}-{stamp}'
target = LAB / 'snapshots' / snapshot_id
shutil.copytree(LAB / 'smb/share', target, symlinks=True, copy_function=shutil.copy2)
if fingerprint(LAB / 'smb/share') != fingerprint(target):
    print('LAB snapshot fingerprint differs', file=sys.stderr)
    raise SystemExit(1)
(target.parent / (snapshot_id + '.json')).write_text(json.dumps(binding))
os.sync()
print(json.dumps({'snapshot_id': snapshot_id,
    'snapshot_at': datetime.now(timezone.utc).isoformat().replace('+00:00', 'Z'),
    'snapshot_manifest_id': binding['manifest_id']}))
